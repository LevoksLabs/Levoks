# Local editing, autosave, import, preview, and ZIP export work without these.
NEXTAUTH_URL=http://localhost:3000
# Generate a cryptographically random secret of at least 32 bytes.
NEXTAUTH_SECRET=
# Optional OAuth login. Callback: /api/auth/callback/github (or /google).
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
# Optional cloud projects; use a database name in the connection URI.
MONGODB_URI=
LEVOKS_ACTIVE_SECRET_KEY=
# JSON object of key IDs to base64-encoded random 32-byte AES keys. Keep old
# keys available until existing records have been re-encrypted with the active key.
LEVOKS_SECRET_KEYS=
# AI, GitHub Contents, and Vercel tokens are entered per tab in the workspace.
